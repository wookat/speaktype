{
  "name": "speaktype-desktop",
  "productName": "SpeakType",
  "version": "0.3.0",
  "private": true,
  "description": "按住快捷键说话，松手把文字落到任意 Windows 程序的光标处",
  "author": "SpeakType",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "electron-vite build && electron-builder --win --x64",
    "pack:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "pack:mac": "electron-vite build && electron-builder --mac --config electron-builder-mac.yml"
  },
  "dependencies": {
    "auto-launch": "5.0.6",
    "electron-log": "5.4.3",
    "electron-store": "11.0.2",
    "koffi": "2.14.1",
    "lucide-react": "^0.560.0",
    "pinyin-pro": "^3.28.2",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/auto-launch": "5.0.5",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "opencc-js": "^1.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
